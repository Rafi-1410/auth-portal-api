NODE_ENV=development
PORT=3000

# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_portal
# Set "true" untuk database cloud yang wajib SSL (Heroku, Supabase, Neon, dll.)
DATABASE_SSL=false

# Minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=12
